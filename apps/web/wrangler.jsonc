{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pactwoven-web-development",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pactwoven-web-development"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [],
  "send_metrics": false,
  "vars": {
    "CLERK_TELEMETRY_DISABLED": "true",
    "NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED": "true"
  }
}
